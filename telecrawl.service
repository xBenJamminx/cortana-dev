[Unit]
Description=Telecrawl - Telegram Message Logger
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m telecrawl.cli tail --chat-id -1003856131939
WorkingDirectory=/root/.openclaw/workspace
Environment="TELEGRAM_BOT_TOKEN=your-bot-token-here"
Environment="PYTHONPATH=/root/.openclaw/workspace/lib"
Restart=always
RestartSec=5
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
